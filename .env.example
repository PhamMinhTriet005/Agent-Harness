# API Key for OpenAI or any OpenAI-compatible provider (e.g. Groq, OpenRouter, Ollama)
OPENAI_API_KEY=your_api_key_here

# Base URL for OpenAI API (e.g. https://api.groq.com/openai/v1 or https://api.openai.com/v1)
OPENAI_API_BASE=https://api.groq.com/openai/v1

# Model Name
GPT_MODEL=openai/gpt-oss-120b

